{
  "name": "bloom-canvas",
  "version": "1.1.5",
  "private": true,
  "description": "An open-source desktop workspace for AI image creation, prompt refinement, and structured logo exploration.",
  "keywords": [
    "ai-image-generation",
    "desktop-app",
    "electron",
    "logo-design",
    "openai-compatible",
    "prompt-engineering",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/def-peter/bloom-canvas#readme",
  "bugs": {
    "url": "https://github.com/def-peter/bloom-canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/def-peter/bloom-canvas.git"
  },
  "license": "MIT",
  "author": "def-peter",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "yarn": ">=4.0.0"
  },
  "dependenciesMeta": {
    "electron": {
      "built": true
    },
    "esbuild": {
      "built": true
    }
  },
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest",
    "test:run": "vitest run --maxWorkers=4",
    "verify:package": "node scripts/verify-packaged-app.mjs dist",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "yarn typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "yarn build && electron-builder --dir",
    "build:win": "yarn build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "antd": "^6.5.0",
    "electron-updater": "^6.3.9",
    "nanoid": "^5.1.16",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "^3.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  }
}
